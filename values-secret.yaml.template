version: '2.0'
secrets:
- name: pgvector
  vaultPrefixes:
  - hub
  fields:
  - name: user
    value: ''
  - name: password
    onMissingValue: generate
    vaultPolicy: validatedPatternDefaultPolicy
  - name: host
    value: ''
  - name: port
    value: ''
  - name: dbname
    value: ''
- name: llm-service
  vaultPrefixes:
  - hub
  fields:
  - name: HF_TOKEN
    onMissingValue: prompt
- name: configure-pipeline
  vaultPrefixes:
  - hub
  fields:
  - name: AWS_S3_ENDPOINT
    value: ''
  - name: LLAMASTACK_BASE_URL
    value: ''
  - name: OGX_AI_BASE_URL
    value: ''
  - name: DS_PIPELINE_URL
    value: ''
  - name: SOURCE
    value: ''
  - name: EMBEDDING_MODEL
    value: ''
  - name: NAME
    value: ''
  - name: VERSION
    value: ''
- name: llama-stack
  vaultPrefixes:
  - hub
  fields:
  - name: GOOGLE_APPLICATION_CREDENTIALS
    onMissingValue: prompt
